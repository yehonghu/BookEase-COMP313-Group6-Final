# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Configuration
# Production requires an Atlas connection string; do not commit a real URI.
MONGODB_URI=mongodb://localhost:27017/bookease

# JWT Configuration
# Production requires a unique value with at least 32 characters.
JWT_SECRET=replace_with_a_long_unique_secret_for_production
JWT_EXPIRES_IN=7d

# Production bootstrap administrator (optional in development)
# Set both values together in the hosting dashboard. Never commit real credentials.
BOOTSTRAP_ADMIN_NAME=BookEase Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_12_character_minimum_password

# Public-beta security controls
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=25
# Enable only after configuring durable object storage. Free Render services have ephemeral disks.
UPLOADS_ENABLED=false

# Email Configuration (optional; contact messages are still stored without SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
CONTACT_TO_EMAIL=your_email@gmail.com
CONTACT_FROM_EMAIL=BookEase <no-reply@bookease.com>
